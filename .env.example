# Copy to .env.local and fill in. Never commit .env.local.

# Google Gemini — shop-profile extraction (server only)
GEMINI_API_KEY=

# Groq — Whisper speech-to-text fallback (server only)
GROQ_API_KEY=

# Supabase — the NEXT_PUBLIC_ ones are safe in the browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — bypasses RLS. Server only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Gemini models. Defaults: gemini-3.5-flash, falling back to gemini-3.5-flash-lite
# when the main model is busy or slow. Set GEMINI_FALLBACK_MODEL= (empty) to disable the fallback.
GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=
# Thinking level for the main model: minimal (default) | low | medium | high | off
# GEMINI_THINKING=

# Public URL used for share links, QR codes, Open Graph and JSON-LD (e.g. https://vaanistore.vercel.app)
NEXT_PUBLIC_SITE_URL=

# ── Production extras ──
# Upstash Redis (free tier) — shared rate limits across serverless instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max AI calls per day for the whole app (cost cap). Default 3000.
AI_DAILY_LIMIT=

# Optional Slack/Discord webhook that receives server errors
ERROR_WEBHOOK_URL=

# Contact email shown on the privacy page
NEXT_PUBLIC_CONTACT_EMAIL=
